# Copy to backend/.env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Only if your key is not tied to one workspace (the API then answers: "must include the anthropic-workspace-id header")
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
# Demo login for the officer UI (defaults: officer / seva-demo-2026)
# OFFICER_USER=officer
# OFFICER_PASSWORD=choose-something
# MAX_LIVE_ANALYSES_PER_DAY=40
# Optional overrides
# ANTHROPIC_MODEL=claude-sonnet-5-5
# DB_PATH=seva.db
# CORS_ORIGINS=http://localhost:5173
